{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/movie_semantic.schema.json",
  "title": "Movie Semantic JSON",
  "description": "Semantic JSON output for MovieScene and LevelSequence assets.",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status", "movie"],
  "properties": {
    "format": {
      "const": "uasset_read.movie_semantic"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": ["standard", "debug"]
    },
    "asset_type": {
      "type": "string"
    },
    "asset": {
      "$ref": "#/$defs/AssetMeta"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "movie": {
      "$ref": "#/$defs/Movie"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageInfo"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReferenceEntry"
      }
    },
    "evidence": {
      "type": "array"
    }
  },
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["name", "package"],
      "properties": {
        "name": { "type": "string" },
        "package": { "type": "string" },
        "class": { "type": "string" },
        "plugin": { "type": ["string", "null"] },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": { "type": "string", "enum": ["complete", "partial", "failed"] },
        "representation": { "type": "string", "enum": ["full", "partial", "opaque"] }
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "properties": {
        "scopes_expected": { "type": "integer" },
        "scopes_available": { "type": "integer" }
      }
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" }
      }
    },
    "ReferenceEntry": {
      "type": "object",
      "required": ["kind", "index"],
      "properties": {
        "kind": { "type": "string" },
        "index": { "type": "integer" },
        "label": { "type": "string" }
      }
    },
    "Movie": {
      "type": "object",
      "properties": {
        "scene_summary": { "$ref": "#/$defs/SceneSummary" },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackInfo" }
        }
      }
    },
    "SceneSummary": {
      "type": "object",
      "properties": {
        "track_count": { "type": "integer" },
        "spawnable_count": { "type": "integer" },
        "possessable_count": { "type": "integer" },
        "binding_count": { "type": "integer" },
        "marked_frame_count": { "type": "integer" },
        "frame_rate": { "type": "number" }
      }
    },
    "TrackInfo": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      }
    }
  }
}
