{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/standalone_semantic.schema.json",
  "title": "Standalone Types Semantic JSON",
  "description": "Semantic JSON output for standalone types (SubsurfaceProfile, CurveFloat, CurveLinearColor, CurveVector, FoliageType, FoliageType_InstancedStaticMesh).",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status", "standalone"],
  "properties": {
    "format": {
      "const": "uasset_read.standalone_semantic"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["standard", "debug"]
    },
    "asset_type": {
      "type": "string"
    },
    "asset": {
      "$ref": "#/$defs/AssetMeta"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "standalone": {
      "$ref": "#/$defs/Standalone"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageInfo"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["package", "name"],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "generated_class": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": {
          "enum": ["complete", "partial", "failed"]
        },
        "representation": {
          "enum": ["full", "partial", "opaque"]
        }
      },
      "additionalProperties": false
    },
    "Standalone": {
      "type": "object",
      "properties": {
        "profile_properties": {
          "$ref": "#/$defs/ProfileProperties"
        },
        "curve_data": {
          "$ref": "#/$defs/CurveData"
        },
        "foliage_properties": {
          "$ref": "#/$defs/FoliageProperties"
        }
      },
      "additionalProperties": false
    },
    "ProfileProperties": {
      "type": "object",
      "properties": {
        "surface_albedo": {},
        "mean_free_path": {},
        "mean_free_path_dist": {},
        "subsurface_color": {},
        "boundary_color_bleed": {},
        "extinction_scale": {},
        "normal_scale": {},
        "custom_profile_curve": {}
      },
      "additionalProperties": false
    },
    "CurveData": {
      "type": "object",
      "required": ["key_count"],
      "properties": {
        "key_count": {
          "type": "integer",
          "minimum": 0
        },
        "pre_infinity_extrap": {
          "type": "string"
        },
        "post_infinity_extrap": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurveKey"
          }
        }
      },
      "additionalProperties": false
    },
    "CurveKey": {
      "type": "object",
      "properties": {
        "time": {},
        "value": {},
        "interpolation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FoliageProperties": {
      "type": "object",
      "properties": {
        "mesh_ref": {},
        "material_refs": {},
        "density": {},
        "scaling": {},
        "scale_min": {},
        "scale_max": {},
        "collision_radius": {},
        "height_range_min": {},
        "height_range_max": {}
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "required": ["scopes_expected", "scopes_available", "scopes_unavailable"],
      "properties": {
        "scopes_expected": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_available": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
