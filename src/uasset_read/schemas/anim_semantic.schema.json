{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/anim_semantic.schema.json",
  "title": "Animation Semantic JSON",
  "description": "Semantic JSON output for Animation assets (AnimSequence, AnimMontage, PoseAsset, AnimCurveCompressionSettings).",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status", "anim"],
  "properties": {
    "format": {
      "const": "uasset_read.anim_semantic"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["standard", "debug"]
    },
    "asset_type": {
      "const": "animation"
    },
    "asset": {
      "$ref": "#/$defs/AssetMeta"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "anim": {
      "$ref": "#/$defs/AnimData"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageInfo"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["package", "name"],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "generated_class": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": {
          "enum": ["complete", "partial", "failed"]
        },
        "representation": {
          "enum": ["full", "partial", "opaque"]
        }
      },
      "additionalProperties": false
    },
    "AnimData": {
      "type": "object",
      "properties": {
        "anim_summary": {
          "$ref": "#/$defs/AnimSummary"
        },
        "tracks": {
          "$ref": "#/$defs/AnimTracks"
        },
        "compression": {
          "type": "object"
        },
        "montage_summary": {
          "$ref": "#/$defs/MontageSummary"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "branching_points": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pose_summary": {
          "$ref": "#/$defs/PoseSummary"
        },
        "poses": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "compression_settings": {
          "$ref": "#/$defs/CompressionSettings"
        }
      },
      "additionalProperties": false
    },
    "AnimSummary": {
      "type": "object",
      "properties": {
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "bone_track_count": {
          "type": "integer",
          "minimum": 0
        },
        "curve_count": {
          "type": "integer",
          "minimum": 0
        },
        "motion_extractor_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_additive_animation": {
          "type": "boolean"
        },
        "has_root_motion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "AnimTracks": {
      "type": "object",
      "properties": {
        "translation": {
          "type": "object"
        },
        "rotation": {
          "type": "object"
        },
        "scale": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "MontageSummary": {
      "type": "object",
      "properties": {
        "slot_count": {
          "type": "integer",
          "minimum": 0
        },
        "section_count": {
          "type": "integer",
          "minimum": 0
        },
        "branching_point_count": {
          "type": "integer",
          "minimum": 0
        },
        "blend_in_time": {
          "type": "number",
          "minimum": 0
        },
        "blend_out_time": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PoseSummary": {
      "type": "object",
      "properties": {
        "pose_count": {
          "type": "integer",
          "minimum": 0
        },
        "blend_pose_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_scale": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CompressionSettings": {
      "type": "object",
      "properties": {
        "codec_class": {
          "type": "string"
        },
        "max_curve_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_threshold": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "required": ["scopes_expected", "scopes_available", "scopes_unavailable"],
      "properties": {
        "scopes_expected": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_available": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
