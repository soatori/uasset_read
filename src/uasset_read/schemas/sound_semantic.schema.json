{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/sound_semantic.schema.json",
  "title": "Sound Semantic JSON",
  "description": "Semantic JSON output for Sound assets (SoundWave, SoundCue, SoundAttenuation).",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status", "sound"],
  "properties": {
    "format": {
      "const": "uasset_read.sound_semantic"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["standard", "debug"]
    },
    "asset_type": {
      "enum": ["sound_wave", "sound_cue", "sound_attenuation"]
    },
    "asset": {
      "$ref": "#/$defs/AssetMeta"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sound": {
      "$ref": "#/$defs/Sound"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageInfo"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["package", "name"],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "generated_class": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": {
          "enum": ["complete", "partial", "failed"]
        },
        "representation": {
          "enum": ["full", "partial", "opaque"]
        }
      },
      "additionalProperties": false
    },
    "Sound": {
      "type": "object",
      "properties": {
        "resource_properties": {
          "$ref": "#/$defs/ResourceProperties"
        },
        "bulk_summary": {
          "$ref": "#/$defs/BulkSummary"
        },
        "graph_metadata": {
          "$ref": "#/$defs/GraphMetadata"
        },
        "attenuation_properties": {
          "$ref": "#/$defs/AttenuationProperties"
        }
      },
      "additionalProperties": false
    },
    "ResourceProperties": {
      "type": "object",
      "properties": {
        "duration": {
          "type": ["number", "null"]
        },
        "sample_rate": {
          "type": ["integer", "null"]
        },
        "channel_count": {
          "type": ["integer", "null"]
        },
        "format": {
          "type": ["string", "null"]
        },
        "compression_quality": {
          "type": ["number", "null"]
        },
        "sound_group": {
          "type": ["string", "null"]
        },
        "loading_behavior": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "BulkSummary": {
      "type": "object",
      "properties": {
        "total_pcm_bytes": {
          "type": ["integer", "null"]
        },
        "compressed_bytes": {
          "type": ["integer", "null"]
        },
        "chunk_count": {
          "type": ["integer", "null"]
        },
        "is_streaming": {
          "type": ["boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "GraphMetadata": {
      "type": "object",
      "required": ["class_name"],
      "properties": {
        "class_name": {
          "type": "string"
        },
        "node_count": {
          "type": ["integer", "null"]
        },
        "mixer_node_count": {
          "type": ["integer", "null"]
        },
        "wave_player_count": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "AttenuationProperties": {
      "type": "object",
      "properties": {
        "attenuation_shape": {
          "type": ["string", "null"]
        },
        "attenuation_radius": {
          "type": ["number", "null"]
        },
        "falloff_function": {
          "type": ["string", "null"]
        },
        "spatialization_algorithm": {
          "type": ["string", "null"]
        },
        "battenuate_over_distance": {
          "type": ["boolean", "null"]
        },
        "battenuate_over_time": {
          "type": ["boolean", "null"]
        },
        "distance_algorithm": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "required": ["scopes_expected", "scopes_available", "scopes_unavailable"],
      "properties": {
        "scopes_expected": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_available": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}