{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/texture_semantic.schema.json",
  "title": "Texture Semantic JSON",
  "description": "Semantic JSON output for Texture (Texture2D, TextureCube, etc.) assets.",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status", "texture"],
  "properties": {
    "format": {
      "const": "uasset_read.texture_semantic"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["standard", "debug"]
    },
    "asset_type": {
      "const": "texture"
    },
    "asset": {
      "$ref": "#/$defs/AssetMeta"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "texture": {
      "$ref": "#/$defs/Texture"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageInfo"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticEntry"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["package", "name"],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "generated_class": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": {
          "enum": ["complete", "partial", "failed"]
        },
        "representation": {
          "enum": ["full", "partial", "opaque"]
        }
      },
      "additionalProperties": false
    },
    "Texture": {
      "type": "object",
      "properties": {
        "resource_properties": {
          "$ref": "#/$defs/ResourceProperties"
        },
        "bulk_summary": {
          "$ref": "#/$defs/BulkSummary"
        }
      },
      "additionalProperties": false
    },
    "ResourceProperties": {
      "type": "object",
      "properties": {
        "size_x": {
          "type": "integer",
          "minimum": 0
        },
        "size_y": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string"
        },
        "num_mips": {
          "type": "integer",
          "minimum": 0
        },
        "is_streaming": {
          "type": "boolean"
        },
        "streaming_channels": {
          "type": "integer",
          "minimum": 0
        },
        "lod_group": {
          "type": "string"
        },
        "address_x": {
          "type": "string"
        },
        "address_y": {
          "type": "string"
        },
        "filter": {
          "type": "string"
        },
        "srgb": {
          "type": "boolean"
        },
        "cube_face_count": {
          "type": "integer",
          "const": 6
        }
      },
      "additionalProperties": false
    },
    "BulkSummary": {
      "type": "object",
      "properties": {
        "total_mip_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "compressed_mip_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_mip": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "required": ["scopes_expected", "scopes_available", "scopes_unavailable"],
      "properties": {
        "scopes_expected": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_available": {
          "type": "integer",
          "minimum": 0
        },
        "scopes_unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
