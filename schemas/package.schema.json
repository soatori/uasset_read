{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/package.schema.json",
  "title": "uasset_read PackageIR Output",
  "description": "JSON output schema for the uasset_read parser PackageIR. Describes the complete structure after .uasset file parsing.",
  "type": "object",
  "required": ["status", "summary", "exports", "warnings", "diagnostics", "metadata", "import_map", "name_map", "statistics"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference (only present when include_schema=True)"
    },
    "status": {
      "$ref": "#/$defs/StatusInfo",
      "description": "Parse status information"
    },
    "summary": {
      "$ref": "#/$defs/PackageSummary",
      "description": "Package header summary (aligned with UE FPackageFileSummary)"
    },
    "exports": {
      "type": "array",
      "description": "Export object list",
      "items": {
        "$ref": "#/$defs/ExportEntry"
      }
    },
    "blueprint": {
      "$ref": "#/$defs/BlueprintData",
      "description": "Blueprint metadata (only present for Blueprint class assets)"
    },
    "variables": {
      "type": "array",
      "description": "Blueprint variable list",
      "items": {
        "$ref": "#/$defs/VariableEntry"
      }
    },
    "decompiled_functions": {
      "type": "array",
      "description": "Decompiled function list",
      "items": {
        "$ref": "#/$defs/DecompiledFunction"
      }
    },
    "execution_chains": {
      "type": "array",
      "description": "Execution chain list",
      "items": {
        "$ref": "#/$defs/ExecutionChain"
      }
    },
    "resolved_parent_assets": {
      "type": "array",
      "description": "Resolved parent asset list",
      "items": {
        "type": "object"
      }
    },
    "inherited_blueprint_graphs": {
      "type": "array",
      "description": "Inherited Blueprint graph list",
      "items": {
        "type": "object"
      }
    },
    "logic_sources": {
      "type": "array",
      "description": "Logic source list",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "description": "Parse error list",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "description": "Diagnostic information list",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/RawLegacyDiagnostic" },
          { "$ref": "#/$defs/FoldedLegacyDiagnostic" },
          { "$ref": "#/$defs/StructuredDiagnostic" },
          { "$ref": "#/$defs/AggregatedStructuredDiagnostic" }
        ]
      }
    },
    "diagnostics_truncated_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of diagnostic entries omitted due to capacity limits"
    },
    "warnings": {
      "type": "array",
      "description": "Parse warning list",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Asset metadata"
    },
    "import_map": {
      "type": "array",
      "description": "Import table",
      "items": {
        "type": "object"
      }
    },
    "name_map": {
      "type": "array",
      "description": "Name table",
      "items": {
        "type": "string"
      }
    },
    "statistics": {
      "type": "object",
      "description": "Export statistics"
    },
    "asset_registry_data": {
      "type": ["object", "null"],
      "description": "Asset registry data"
    },
    "anim_blueprint": {
      "$ref": "#/$defs/AnimBlueprintData",
      "description": "Animation Blueprint data (only present for AnimBlueprint assets)"
    },
    "anim_sequence": {
      "$ref": "#/$defs/AnimSequenceData",
      "description": "Animation sequence data (only present for AnimSequence assets)"
    },
    "anim_montage": {
      "$ref": "#/$defs/AnimMontageData",
      "description": "Animation montage data (only present for AnimMontage assets)"
    },
    "function_graphs": {
      "type": "array",
      "description": "Function graph data (only present when include_function_graphs=True)",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "StatusInfo": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "partial", "failed"],
          "description": "Parse status"
        },
        "message": {
          "type": ["string", "null"],
          "description": "Status message"
        },
        "code": {
          "type": ["string", "null"],
          "description": "Status code"
        }
      }
    },
    "RawLegacyDiagnostic": {
      "type": "object",
      "required": ["kind", "severity", "current_pos", "target_offset", "read_size", "file_size"],
      "properties": {
        "kind": { "type": "string" },
        "severity": { "type": "string" },
        "current_pos": { "type": "integer" },
        "target_offset": { "type": "integer" },
        "read_size": { "type": "integer" },
        "file_size": { "type": "integer" }
      }
    },
    "FoldedLegacyDiagnostic": {
      "type": "object",
      "required": ["kind", "field", "error", "error_pattern", "count"],
      "not": { "required": ["severity"] },
      "properties": {
        "kind": { "type": "string" },
        "field": { "type": "string" },
        "error": { "type": "string" },
        "error_pattern": { "type": "string" },
        "count": { "type": "integer", "minimum": 2 },
        "pos_range": { "$ref": "#/$defs/NumericRange" }
      }
    },
    "StructuredDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "asset", "stage", "offset", "raw_value", "ue_version", "fallback", "message"],
      "not": { "required": ["count"] },
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string" },
        "asset": { "type": ["string", "null"] },
        "stage": { "type": "string" },
        "offset": { "type": "integer" },
        "raw_value": {},
        "ue_version": { "type": ["string", "null"] },
        "fallback": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "AggregatedStructuredDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "stage", "fallback", "count", "message_examples", "offset_range", "offset_examples"],
      "allOf": [
        { "anyOf": [{ "required": ["asset"] }, { "required": ["asset_examples"] }] },
        { "anyOf": [{ "required": ["ue_version"] }, { "required": ["ue_version_examples"] }] }
      ],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string" },
        "asset": { "type": ["string", "null"] },
        "asset_examples": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": ["string", "null"] }
        },
        "stage": { "type": "string" },
        "ue_version": { "type": ["string", "null"] },
        "ue_version_examples": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": ["string", "null"] }
        },
        "fallback": { "type": ["string", "null"] },
        "count": { "type": "integer", "minimum": 2 },
        "message_examples": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "raw_value_range": { "$ref": "#/$defs/NumericRange" },
        "raw_value_examples": {
          "type": "array",
          "maxItems": 3,
          "items": {}
        },
        "offset_range": { "$ref": "#/$defs/NumericRange" },
        "offset_examples": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "integer" }
        }
      }
    },
    "NumericRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "PackageSummary": {
      "type": "object",
      "required": ["package_name", "package_class", "package_flags", "total_export_count", "total_import_count", "ue_version"],
      "properties": {
        "package_name": {
          "type": "string",
          "description": "Package name (e.g. /Game/Path/AssetName)"
        },
        "package_class": {
          "type": "string",
          "description": "Package class name"
        },
        "package_flags": {
          "type": "integer",
          "description": "Package flags (raw value)"
        },
        "package_flags_decoded": {
          "type": "array",
          "description": "Decoded package flags list",
          "items": {
            "type": "string"
          }
        },
        "total_export_count": {
          "type": "integer",
          "description": "Total export count"
        },
        "total_import_count": {
          "type": "integer",
          "description": "Total import count"
        },
        "ue_version": {
          "type": "string",
          "description": "UE version string"
        },
        "saved_hash": {
          "type": ["string", "null"],
          "description": "Saved hash (hex string)"
        },
        "total_properties": {
          "type": "integer",
          "description": "Total property count across all exports"
        },
        "total_name_entries": {
          "type": "integer",
          "description": "Total name table entry count"
        }
      }
    },
    "ExportEntry": {
      "type": "object",
      "required": ["object_name", "object_class", "serial_size"],
      "properties": {
        "object_name": {
          "type": "string",
          "description": "Export object name"
        },
        "object_class": {
          "type": "string",
          "description": "Export object class name"
        },
        "asset_class": {
          "type": ["string", "null"],
          "description": "Owning asset class resolved from the nearest asset export"
        },
        "serial_size": {
          "type": "integer",
          "description": "Serialization size (bytes)"
        },
        "parent_class": {
          "type": ["string", "null"],
          "description": "Parent class name"
        },
        "properties": {
          "type": "array",
          "description": "Property list",
          "items": {
            "$ref": "#/$defs/PropertyEntry"
          }
        },
        "graphs": {
          "type": "array",
          "description": "Graph list",
          "items": {
            "$ref": "#/$defs/GraphEntry"
          }
        },
        "parse_status": {
          "type": "string",
          "enum": ["success", "partial", "failed", "opaque", "partial_metadata"],
          "description": "Parse status (only present when not success)"
        },
        "fallback_reason": {
          "type": ["string", "null"],
          "description": "Fallback reason"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error message"
        }
      }
    },
    "PropertyEntry": {
      "type": "object",
      "required": ["name", "type", "value"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Property name"
        },
        "type": {
          "type": "string",
          "description": "Property type"
        },
        "value": {
          "description": "Property value (type depends on property type)"
        },
        "array_index": {
          "type": "integer",
          "description": "Array index"
        },
        "guid": {
          "type": ["string", "null"],
          "description": "GUID"
        }
      }
    },
    "GraphEntry": {
      "type": "object",
      "required": ["graph_name", "graph_guid", "nodes", "execution_chains"],
      "properties": {
        "graph_name": {
          "type": "string",
          "description": "Graph name"
        },
        "graph_guid": {
          "type": ["string", "null"],
          "description": "Graph GUID (32-char lowercase hex)"
        },
        "graph_type": {
          "type": ["string", "null"],
          "description": "Graph type"
        },
        "nodes": {
          "type": "array",
          "description": "Node list",
          "items": {
            "$ref": "#/$defs/NodeEntry"
          }
        },
        "execution_chains": {
          "type": "array",
          "description": "Execution chains",
          "items": {
            "$ref": "#/$defs/GraphExecutionChain"
          }
        },
        "subgraphs": {
          "type": "array",
          "description": "Subgraph list",
          "items": {
            "$ref": "#/$defs/GraphEntry"
          }
        }
      }
    },
    "GraphBranchPath": {
      "type": "object",
      "required": ["from_node_guid", "output_pin", "to_node_guid"],
      "properties": {
        "from_node_guid": {"type": "string", "minLength": 1},
        "output_pin": {"type": "string", "minLength": 1},
        "to_node_guid": {"type": "string", "minLength": 1}
      }
    },
    "GraphExecutionChain": {
      "type": "object",
      "required": ["start_event", "chains", "has_cycle"],
      "properties": {
        "start_event": {"type": "string", "minLength": 1},
        "chains": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "has_cycle": {"type": "boolean"},
        "chain_metadata": {
          "type": "object",
          "properties": {
            "branch_count": {"type": "integer", "minimum": 0}
          }
        },
        "branch_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/GraphBranchPath"}
        }
      }
    },
    "NodeEntry": {
      "type": "object",
      "required": ["node_guid", "node_class", "pins"],
      "properties": {
        "node_guid": {
          "type": ["string", "null"],
          "description": "Node GUID (32-char lowercase hex; null when unavailable)"
        },
        "node_class": {
          "type": "string",
          "description": "Node class name"
        },
        "node_comment": {
          "type": ["string", "null"],
          "description": "Node comment"
        },
        "pins": {
          "type": "array",
          "description": "Pin list",
          "items": {
            "$ref": "#/$defs/PinEntry"
          }
        },
        "execution_flow": {
          "type": "array",
          "description": "Execution flow information",
          "items": {
            "type": "object"
          }
        },
        "macro_expansion": {
          "type": ["object", "null"],
          "description": "Macro expansion information"
        }
      }
    },
    "PinEntry": {
      "type": "object",
      "required": ["pin_name", "pin_category", "linked_to", "direction"],
      "properties": {
        "pin_name": {
          "type": "string",
          "description": "Pin name"
        },
        "pin_type": {
          "type": "string",
          "description": "Pin type"
        },
        "pin_category": {
          "type": "string",
          "description": "Pin primary category (standard output)"
        },
        "pin_type_value": {
          "type": ["string", "null"],
          "description": "Pin type value"
        },
        "linked_to": {
          "type": "array",
          "description": "List of connected Pin GUIDs",
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "type": "string",
          "description": "Direction"
        },
        "default_value": {
          "type": ["string", "null"],
          "description": "Default value"
        }
      }
    },
    "BlueprintData": {
      "type": "object",
      "properties": {
        "parent_class": {
          "type": ["string", "null"],
          "description": "Parent class name"
        },
        "description": {
          "type": "string",
          "description": "Blueprint description"
        },
        "interfaces": {
          "type": "array",
          "description": "Implemented interface list",
          "items": {
            "type": "object"
          }
        },
        "functions": {
          "type": "array",
          "description": "Blueprint function list",
          "items": {
            "$ref": "#/$defs/BlueprintFunction"
          }
        },
        "events": {
          "type": "array",
          "description": "Blueprint event list",
          "items": {
            "$ref": "#/$defs/BlueprintEvent"
          }
        },
        "components": {
          "type": "array",
          "description": "Component list",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "BlueprintFunction": {
      "type": "object",
      "required": ["name", "return_type", "parameters", "implementation_status"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Function name"
        },
        "return_type": {
          "type": "string",
          "description": "Return type"
        },
        "parameters": {
          "type": "array",
          "description": "Parameter list",
          "items": {
            "type": "object"
          }
        },
        "function_flags": {
          "type": "integer",
          "description": "Function flags"
        },
        "is_pure": {
          "type": "boolean",
          "description": "Whether this is a pure function"
        },
        "is_blueprint_callable": {
          "type": "boolean",
          "description": "Whether this is Blueprint-callable"
        },
        "is_const": {
          "type": "boolean",
          "description": "Whether this is a const function"
        },
        "is_static": {
          "type": "boolean",
          "description": "Whether this is a static function"
        },
        "implementation": {
          "oneOf": [
            { "$ref": "#/$defs/DecompiledFunction" },
            { "type": "null" }
          ],
          "description": "Implementation association"
        },
        "function_graph": {
          "type": ["object", "null"],
          "description": "Function graph data"
        },
        "implementation_status": {
          "type": "string",
          "enum": ["decompiled", "graph_only", "metadata_only", "missing"],
          "description": "Implementation status"
        }
      }
    },
    "BlueprintEvent": {
      "type": "object",
      "required": ["name", "event_type", "parameters", "implementation_status"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Event name"
        },
        "event_type": {
          "type": "string",
          "description": "Event type"
        },
        "parameters": {
          "type": "array",
          "description": "Parameter list",
          "items": {
            "type": "object"
          }
        },
        "is_override": {
          "type": "boolean",
          "description": "Whether this is an override event"
        },
        "override_parent_class": {
          "type": "string",
          "description": "Overridden parent class"
        },
        "implementation": {
          "oneOf": [
            { "$ref": "#/$defs/DecompiledFunction" },
            { "type": "null" }
          ],
          "description": "Implementation association"
        },
        "function_graph": {
          "type": ["object", "null"],
          "description": "Function graph data"
        },
        "implementation_status": {
          "type": "string",
          "enum": ["decompiled", "graph_only", "metadata_only", "missing"],
          "description": "Implementation status"
        }
      }
    },
    "VariableEntry": {
      "type": "object",
      "required": ["name", "type", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Variable name"
        },
        "type": {
          "type": "string",
          "description": "Variable type"
        },
        "kind": {
          "type": "string",
          "enum": ["user", "component", "input_action", "metadata"],
          "description": "Variable kind"
        },
        "default_value": {
          "type": ["string", "null"],
          "description": "Default value"
        },
        "guid": {
          "type": ["string", "null"],
          "description": "GUID"
        },
        "category": {
          "type": "string",
          "description": "Category"
        },
        "property_flags": {
          "type": "integer",
          "description": "Property flags"
        },
        "is_edit_anywhere": {
          "type": "boolean",
          "description": "Whether EditAnywhere is set"
        },
        "is_replicated": {
          "type": "boolean",
          "description": "Whether replicated"
        }
      }
    },
    "DecompiledFunction": {
      "type": "object",
      "required": ["name", "signature", "cpp_code", "parameters", "return_type", "bytecode_status", "translation_status", "bytecode_source", "logic_source", "warnings", "fallback_reasons"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Function name"
        },
        "signature": {
          "type": "string",
          "description": "Function signature"
        },
        "cpp_code": {
          "type": "string",
          "description": "Decompiled C++ code"
        },
        "parameters": {
          "type": "array",
          "description": "Parameter list",
          "items": {
            "type": "object"
          }
        },
        "return_type": {
          "type": "string",
          "description": "Return type"
        },
        "bytecode_status": {
          "type": "string",
          "enum": ["parsed", "no_script", "failed", "unknown"],
          "description": "Bytecode extraction/parsing status"
        },
        "translation_status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "not_applicable"],
          "description": "Translation (C++ code generation) status"
        },
        "bytecode_source": {
          "type": "string",
          "enum": ["function_export", "unknown"],
          "description": "Bytecode extraction source path"
        },
        "logic_source": {
          "type": "string",
          "enum": ["current_asset", "graph_topology"],
          "description": "Origin of the function body logic"
        },
        "bytecode_confidence": {
          "type": "string",
          "enum": ["verified", "no_script", "graph_topology", "failed"],
          "description": "Confidence level of the decompiled function body"
        },
        "error_code": {
          "type": ["string", "null"],
          "description": "Structured error code"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Structured error message"
        },
        "error_context": {
          "type": ["object", "null"],
          "description": "Structured error context (e.g. offsets, indices)"
        },
        "script_metrics": {
          "oneOf": [
            { "$ref": "#/$defs/ScriptMetrics" },
            { "type": "null" }
          ],
          "description": "Script metrics for the function"
        },
        "fallback_reasons": {
          "type": "array",
          "description": "Fallback reason list",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "description": "Translation and degradation warnings",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ScriptMetrics": {
      "type": "object",
      "required": ["bytecode_buffer_size", "serialized_script_size", "serialized_bytes_consumed", "bytecode_bytes_consumed"],
      "properties": {
        "bytecode_buffer_size": {
          "type": "integer",
          "minimum": 0,
          "description": "Total bytecode buffer size in bytes"
        },
        "serialized_script_size": {
          "type": "integer",
          "minimum": 0,
          "description": "Declared serialized script size in bytes"
        },
        "serialized_bytes_consumed": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes consumed from serialized data"
        },
        "bytecode_bytes_consumed": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes consumed from bytecode buffer"
        }
      }
    },
    "ExecutionChain": {
      "type": "object",
      "required": ["event", "chain"],
      "properties": {
        "event": {
          "type": "string",
          "description": "Event name"
        },
        "chain": {
          "type": "array",
          "description": "Execution chain node list",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AnimBlueprintData": {
      "type": "object",
      "properties": {
        "target_skeleton": {
          "type": ["string", "null"],
          "description": "Target skeleton path"
        },
        "baked_state_machines": {
          "type": "array",
          "description": "Baked state machine list",
          "items": {
            "$ref": "#/$defs/BakedStateMachine"
          }
        },
