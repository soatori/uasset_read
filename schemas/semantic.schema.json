{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/semantic.schema.json",
  "title": "uasset_read Asset Semantic JSON",
  "description": "Common schema for uasset_read semantic JSON output. Domain schemas compose via allOf/$ref.",
  "type": "object",
  "required": ["format", "format_version", "mode", "asset_type", "asset", "status"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "format": { "const": "uasset_read.asset_semantic" },
    "format_version": { "const": "1.0" },
    "mode": { "type": "string", "enum": ["standard", "debug"] },
    "asset_type": { "type": "string" },
    "asset": { "$ref": "#/$defs/AssetMeta" },
    "status": { "$ref": "#/$defs/AssetStatus" },
    "references": { "type": "array", "items": { "$ref": "#/$defs/ReferenceEntry" } },
    "coverage": { "$ref": "#/$defs/CoverageInfo" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/DiagnosticEntry" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceEntry" } }
  },
  "additionalProperties": true,
  "$defs": {
    "AssetMeta": {
      "type": "object",
      "required": ["package", "name"],
      "properties": {
        "package": { "type": "string" },
        "name": { "type": "string" },
        "generated_class": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AssetStatus": {
      "type": "object",
      "required": ["parse", "representation"],
      "properties": {
        "parse": { "type": "string", "enum": ["complete", "partial", "failed"] },
        "representation": { "type": "string", "enum": ["full", "partial", "opaque"] }
      },
      "additionalProperties": false
    },
    "ReferenceEntry": {
      "type": "object",
      "required": ["index", "kind", "class_name", "object_name"],
      "properties": {
        "index": { "type": "integer" },
        "kind": { "type": "string", "enum": ["import", "export"] },
        "class_name": { "type": "string" },
        "object_name": { "type": "string" },
        "package_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CoverageInfo": {
      "type": "object",
      "required": ["scopes_expected", "scopes_available"],
      "properties": {
        "scopes_expected": { "type": "integer" },
        "scopes_available": { "type": "integer" },
        "scopes_unavailable": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DiagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
