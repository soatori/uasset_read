{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soatori/uasset_read/schemas/package_document_v2.json",
  "title": "PackageDocument v2",
  "description": "Unified package-level output for uasset_read v2. One document per .uasset/.umap file, expressing all exports as first-class objects.",
  "type": "object",
  "required": ["format", "format_version", "view", "depth", "source", "package", "objects", "payloads", "diagnostics", "summary"],
  "properties": {
    "format": {
      "const": "uasset_read.package",
      "description": "Fixed format identifier."
    },
    "format_version": {
      "const": "2.0",
      "description": "Schema version."
    },
    "view": {
      "type": "string",
      "enum": ["semantic", "raw", "debug"],
      "description": "Determination of field purpose."
    },
    "depth": {
      "type": "string",
      "enum": ["package", "object", "asset", "decode"],
      "description": "Determines parsing cost and detail level."
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "package": {
      "$ref": "#/$defs/PackageInfo"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ObjectEntry"
      },
      "description": "All exports in table-index order."
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "description": "Object-to-object relationships. Omitted only when the requester opted the section out via projection `sections` (#631)."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "description": "Package-level import dependencies. Omitted only when the requester opted the section out via projection `sections` (#631)."
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PayloadDescriptor"
      },
      "description": "Large payload descriptors (texture, audio, etc.)."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "description": "Structured diagnostics."
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "next_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Continuation cursor when objects were truncated."
    },
    "truncation": {
      "type": "object",
      "description": "Truncation metadata emitted when limit or max_bytes cut the page.",
      "properties": {
        "reason": { "type": "string" },
        "total": { "type": "integer" },
        "offset": { "type": "integer" },
        "returned": { "type": "integer" },
        "truncated": { "type": "integer" },
        "budget": { "type": "integer" },
        "actual": { "type": "integer" },
        "objects_dropped": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "debug": {
      "type": "object",
      "description": "Extra parse statistics for the debug view.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceInfo": {
      "type": "object",
      "required": ["kind", "name", "size"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["loose", "pak", "iostore", "memory"],
          "description": "Source container type."
        },
        "name": {
          "type": "string",
          "description": "File or entry name."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Total source size in bytes."
        },
        "path": {
          "type": "string",
          "description": "Relative or absolute path (omitted in agent output for security)."
        }
      },
      "additionalProperties": false
    },
    "PackageInfo": {
      "type": "object",
      "required": ["name", "layout", "package_flags"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Package object path (e.g. /Game/BP_Light)."
        },
        "layout": {
          "type": "string",
          "enum": ["legacy", "zen"],
          "description": "Binary layout family."
        },
        "engine_version": {
          "type": "string",
          "description": "Saved-by engine version string."
        },
        "compatible_engine_version": {
          "type": "string"
        },
        "package_flags": {
          "type": "integer"
        },
        "total_header_size": {
          "type": "integer"
        },
        "export_count": {
          "type": "integer"
        },
        "import_count": {
          "type": "integer"
        },
        "name_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "ObjectEntry": {
      "type": "object",
      "required": ["id", "name"],
      "description": "id/name are the only keys that survive a projection `fields` trim; untrimmed projections carry roles/status too.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(export|import):[0-9]+$",
          "description": "Stable id: table type + zero-based index."
        },
        "table_index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "class": {
          "type": ["string", "null"],
          "description": "Resolved class name (null when unresolvable, e.g. imports with missing outer)."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["asset", "generated_class", "class_default_object", "metadata", "subobject", "graph", "payload_owner"]
          },
          "description": "叠加标签，不是互斥类型。"
        },
        "serial_region": {
          "oneOf": [
            { "$ref": "#/$defs/Region" },
            { "type": "null" }
          ]
        },
        "status": {
          "$ref": "#/$defs/ObjectStatus"
        },
        "properties": {
          "description": "Property bag (raw/debug views, depth >= object)."
        },
        "properties_summary": {
          "$ref": "#/$defs/PropertySummary"
        },
        "semantic": {
          "type": ["object", "null"],
          "description": "Domain-specific extension (only when depth >= asset and handler supports this object)."
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "flags": {
          "type": "integer",
          "description": "EObjectFlags raw value (raw/debug views only)."
        }
      },
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "required": ["offset", "size"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ObjectStatus": {
      "type": "object",
      "required": ["parse", "semantic"],
      "properties": {
        "parse": {
          "type": "string",
          "enum": ["complete", "partial", "opaque", "failed"]
        },
        "semantic": {
          "type": "string",
          "enum": ["complete", "partial", "unavailable", "not_requested"],
          "description": "'complete' means a decoded-tier handler produced the semantics for this object. Summary-tier output (kind/name echoes, light digests such as Niagara, mesh or depth=asset Blueprint summaries) stays 'partial'."
        }
      },
      "additionalProperties": false
    },
    "PropertySummary": {
      "type": "object",
      "required": ["properties", "property_count"],
      "properties": {
        "properties": {
          "type": "object",
          "description": "Bounded compact property view (semantic view, depth >= object, #636): name -> scalar descriptor; containers length-elided; raw blobs excluded."
        },
        "property_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total names in the bag; fewer may be listed (bounded view). Full bag: raw/debug views."
        }
      },
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "description": "Directed edge read as 'from relates-to to': from is the object that carries the reference and to is the referent. Kinds have no universal inverse reading — query the reverse direction by filtering on to with the per-kind meaning. Meaning of to relative to from: outer_of = the Outer (containing object) of from; class_of = the class of from; super_of = the superclass of from; template_of = the template/archetype of from; depends_on = an entry of from's dependency list (from depends on to); preload_of = an object that must be preloaded before from. Contract-reserved kinds (not emitted by the current legacy reader) read from the subject side: generated_class_of = from is the generated class of to; default_object_of = from is the default object of to; references = from references to. Example: {\"kind\": \"outer_of\", \"from\": \"export:5\", \"to\": \"export:2\"} reads 'the Outer of export:5 is export:2', i.e. export:5 is contained in export:2.",
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["outer_of", "class_of", "generated_class_of", "default_object_of", "template_of", "super_of", "depends_on", "preload_of", "references"]
        },
        "from": {
          "type": "string",
          "pattern": "^(export|import):[0-9]+$"
        },
        "to": {
          "type": "string",
          "pattern": "^(export|import):[0-9]+$"
        },
        "target_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "required": ["index", "class", "object_name"],
      "properties": {
        "index": { "type": "integer" },
        "class": { "type": "string" },
        "object_name": { "type": "string" },
        "package_name": {
          "type": "string",
          "description": "Import class package path as carried by the model (#632); empty when the import has no class package."
        }
      },
      "additionalProperties": false
    },
    "PayloadDescriptor": {
      "type": "object",
      "required": ["id", "owner", "kind", "source_region", "offset", "stored_size", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^payload:(export|import):[0-9]+$" },
        "owner": { "type": "string", "pattern": "^(export|import):[0-9]+$" },
        "kind": {
          "type": "string",
          "enum": ["texture_mip", "audio", "mesh_vertex", "mesh_index", "bulk_data", "other"]
        },
        "source_region": {
          "type": "string",
          "enum": ["main", "uexp", "ubulk", "uptnl", "ucas"]
        },
        "offset": { "type": "integer", "minimum": 0 },
        "stored_size": { "type": "integer", "minimum": 0 },
        "logical_size": { "type": ["integer", "null"], "minimum": 0 },
        "compression": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["available", "external", "missing", "unsupported"]
        },
        "hash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message", "stage"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error", "critical"]
        },
        "code": {
          "type": "string",
          "description": "Stable diagnostic code (e.g. PROPERTY_VALUE_REMAINDER)."
        },
        "message": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "description": "Parse stage (e.g. properties.tagged, package.summary)."
        },
        "object_id": {
          "type": "string",
          "pattern": "^(export|import):[0-9]+$"
        },
        "property_path": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "effect": {
          "type": "string",
          "enum": ["semantic_loss", "data_loss", "parse_failure", "recovery"]
        },
        "recoverable": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Aggregation count for repeated identical diagnostics."
        }
      },
      "additionalProperties": false
    },
    "CoverageEntry": {
      "type": "object",
      "required": ["feature", "status"],
      "properties": {
        "feature": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["present", "partial", "missing", "unsupported"]
        },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "required": ["object_count", "asset_object_ids"],
      "properties": {
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "asset_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(export|import):[0-9]+$"
          },
          "description": "Objects with the 'asset' role (sorted by table index)."
        },
        "total_imports": {
          "type": "integer"
        },
        "total_exports": {
          "type": "integer"
        },
        "diagnostic_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      },
      "additionalProperties": false
    }
  }
}
